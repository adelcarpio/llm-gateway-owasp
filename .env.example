# Copia generada por `make bootstrap` -> .env (gitignored). NO pongas valores reales aqui.
# local | ci | production
ENVIRONMENT=local
# El perfil activo (baseline|secure) vive en .env.profile, lo escribe scripts/switch_profile.sh

# --- LLM10 -------------------------------------------------------------
RATE_LIMIT_DEFAULT=10/minute;200/day
# en Docker Compose se usa redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://
MAX_BODY_BYTES=32768
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=1024

# --- Upstream ----------------------------------------------------------
# mock | openai | ollama | anthropic
UPSTREAM_PROVIDER=mock
UPSTREAM_BASE_URL=http://localhost:9000
UPSTREAM_MODEL=mock-llm-1
# inyectada por entorno o Azure Key Vault
UPSTREAM_API_KEY=
UPSTREAM_CONNECT_TIMEOUT=3
UPSTREAM_READ_TIMEOUT=20
UPSTREAM_TOTAL_TIMEOUT=25
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30

# --- Clientes del gateway (solo hashes HMAC, nunca keys en claro) -----
CLIENT_KEY_PEPPER=
# cliente_a:<hmac_hex>,cliente_b:<hmac_hex>
CLIENT_KEY_HASHES=

# --- LLM07 --------------------------------------------------------------
# vacio = aleatorio por arranque
CANARY_TOKEN=
LEAK_NGRAM_WORDS=8

LOG_FILE=logs/gateway.log
